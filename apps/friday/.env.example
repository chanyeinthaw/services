# Copy to .env and keep it private.

# Bootstrap release packaged into the Docker image. The persistent runtime binary
# can update independently of this image version.
FRIDAY_VERSION=v0.0.0-nightly.11
FRIDAY_TARGET=linux-x64
FRIDAY_UPDATE_CHANNEL=nightly
FRIDAY_UPDATE_ON_START=true

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

PI_SETUP_REPOSITORY=git@github.com:chanyeinthaw/pi-setup.git
PI_SETUP_REF=main

GIT_USER_NAME=Chan Nyein Thaw
GIT_USER_EMAIL=chanyeinthaw@gmail.com
