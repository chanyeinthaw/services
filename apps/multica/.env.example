# Copy to .env and replace the required secrets before starting.
# The real .env is ignored by Git.

MULTICA_IMAGE_TAG=v0.4.21
MULTICA_BACKEND_IMAGE=ghcr.io/multica-ai/multica-backend
# Optional backend-only override; useful with a locally built image.
MULTICA_BACKEND_TAG=
MULTICA_WEB_IMAGE=ghcr.io/multica-ai/multica-web

# Host ports. Containers still listen on 8080 and 3000 internally.
# These defaults avoid common development-server ports.
BACKEND_PORT=55472
FRONTEND_PORT=55471

# Dedicated PostgreSQL credentials. This database belongs only to Multica.
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

# Public browser URLs served by Caddy.
APP_ENV=production
FRONTEND_ORIGIN=https://multica.si14.space
CORS_ALLOWED_ORIGINS=https://multica.si14.space,https://multica-api.si14.space
MULTICA_APP_URL=https://multica.si14.space
MULTICA_PUBLIC_URL=https://multica-api.si14.space

# Attachments use the local ./data/uploads bind mount. Leave S3 variables unset.
LOCAL_UPLOAD_DIR=/app/data/uploads
ATTACHMENT_DOWNLOAD_MODE=auto
ATTACHMENT_DOWNLOAD_URL_TTL=30m

# Set one email provider for normal authentication. With both empty, the code
# is printed in the backend logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@multica.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_TLS=starttls
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=multica.example.com

# Caddy is the same-host reverse proxy for the public domains.
MULTICA_TRUSTED_PROXIES=127.0.0.1/32
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32

# Optional signup controls and OAuth.
ALLOW_SIGNUP=true
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
DISABLE_WORKSPACE_CREATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://multica.si14.space/auth/callback

# Optional integrations. Keep secrets in .env.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
MULTICA_VCS_INTEGRATION_ENABLED=true
MULTICA_VCS_SECRET_KEY=
MULTICA_LARK_SECRET_KEY=
MULTICA_SLACK_SECRET_KEY=
MULTICA_WECOM_SECRET_KEY=
MULTICA_DINGTALK_SECRET_KEY=

# Optional server-side LLM and observability settings.
MULTICA_LLM_API_KEY=
MULTICA_LLM_BASE_URL=
MULTICA_LLM_DEFAULT_MODEL=
METRICS_ADDR=
REALTIME_METRICS_TOKEN=
ANALYTICS_DISABLED=true
POSTHOG_API_KEY=

# Keep these blank so the browser uses same-origin /api and /ws through
# multica.si14.space. The API hostname remains available for CLI/daemon use.
REMOTE_API_URL=http://backend:8080
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
