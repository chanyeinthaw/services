{
  "$schema": "https://opencode.ai/config.json",
  "model": "internal/gpt-5.6-sol",
  "provider": {
    "internal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal LLM Proxy",
      "options": {
        "baseURL": "https://llm.app.internal/v1",
        "apiKey": "{env:INTERNAL_LLM_API_KEY}",
        "timeout": 720000
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow"
  }
}
