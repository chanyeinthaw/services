# Copy this file to .env. Never commit .env.

# A Multica personal access token. Create it in Multica Settings, or provide
# the token you already created for this runtime.
MULTICA_TOKEN=mul_replace_me

# The daemon accepts http(s) or ws(s), and normalizes /ws automatically.
MULTICA_SERVER_URL=https://multica-api.si14.space
MULTICA_APP_URL=https://multica.si14.space

# Optional: select one workspace explicitly. If empty, `multica login` and the
# daemon discover all workspaces available to this token.
MULTICA_WORKSPACE_ID=

MULTICA_DEVICE_NAME=silicon-multica-runtime
MULTICA_RUNTIME_NAME=Docker Pi Runtime
MULTICA_REF=feat/pi-thinking-model-resolution
# Canonical source for release tags used by `git describe` during CLI builds.
MULTICA_TAG_REPOSITORY=https://github.com/multica-ai/multica.git
PI_SETUP_REF=main

# Persistent task workspace root inside the container.
MULTICA_WORKSPACES_ROOT=/workspace

# The daemon is built from your fork, so upstream self-update stays disabled.
MULTICA_DAEMON_AUTO_UPDATE=false

# SSH. Public keys are mounted/imported by compose. This binds SSH to the
# host's Tailscale IP so oxygen can reach the runtime over the tailnet.
SSH_ENABLED=true
SSH_BIND_ADDRESS=100.68.212.40
SSH_PUBLISHED_PORT=55222
SSH_AGENT_SOCKET=/run/user/1000/gcr/ssh

# Tailscale is opt-in. Set true and provide a reusable auth key only after
# deciding whether the container should be its own Tailscale node.
TAILSCALE_ENABLED=false
TAILSCALE_AUTHKEY=
TAILSCALE_EXTRA_ARGS=--hostname=multica-runtime
TAILSCALED_EXTRA_ARGS=

# Paths on the host to public keys. The default silicon path is valid for this
# Services host. Set OXYGEN_SSH_PUBLIC_KEY_FILE to an accessible copied public
# key file; Docker cannot mount a path that exists only on oxygen.
SILICON_SSH_PUBLIC_KEY_FILE=/home/chan/.ssh/id_ed25519.pub
OXYGEN_SSH_PUBLIC_KEY_FILE=/home/chan/Services/apps/multica-daemon/secrets/oxygen.pub

GIT_USER_NAME=Chan Nyein Thaw
GIT_USER_EMAIL=chanyeinthaw@gmail.com
